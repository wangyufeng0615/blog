l":20,"zs":"localisation/simp_chinese/defense_platform_policies_l_simp_chinese.yml","zl":16,"status":"paired","id":"texts:14140"},{"key":"defense_platform_resilient_frames_name","zh":"$defense_platform_resilient_frames$","en":"$defense_platform_resilient_frames$","source":"defense_platform_policies","category":"外交与势力","namespace":"gameplay","es":"localisation/english/defense_platform_policies_l_english.yml","el":21,"zs":"localisation/simp_chinese/defense_platform_policies_l_simp_chinese.yml","zl":17,"status":"paired","id":"texts:14141"},{"key":"defense_platform_resilient_frames_desc","zh":"冗余动力核心与模块化框架让受损严重的平台得以关机并重启，而非直接解体。\\n\\n§E防御平台在战斗中只会瘫痪而非被摧毁，并会在战斗结束后重新激活。§!","en":"Redundant power cores and modular framing let crippled platforms power down and reboot rather than break apart.\\n\\n§EDefensive platforms are disabled instead of destroyed, reactivating once the fighting ends.§!","source":"defense_platform_policies","category":"外交与势力","namespace":"gameplay","es":"localisation/english/defense_platform_policies_l_english.yml","el":22,"zs":"localisation/simp_chinese/defense_platform_policies_l_simp_chinese.yml","zl":18,"status":"paired","id":"texts:14142"},{"key":"defense_platform_provocation_arrays","zh":"挑衅阵列","en":"Provocation Arrays","source":"defense_platform_policies","category":"外交与势力","namespace":"gameplay","es":"localisation/english/defense_platform_policies_l_english.yml","el":24,"zs":"localisation/simp_chinese/defense_platform_policies_l_simp_chinese.yml","zl":19,"status":"paired","id":"texts:14143"},{"key":"defense_platform_provocation_arrays_name","zh":"$defense_platform_provocation_arrays$","en":"$defense_platform_provocation_arrays$","source":"defense_platform_policies","category":"外交与势力","namespace":"gameplay","es":"localisation/english/defense_platform_policies_l_english.yml","el":25,"zs":"localisation/simp_chinese/defense_platform_policies_l_simp_chinese.yml","zl":20,"status":"paired","id":"texts:14144"},{"key":"defense_platform_provocation_arrays_d