oids_l_simp_chinese.yml","zl":31,"status":"paired","id":"texts:47704"},{"key":"triggered_selective_kinship","zh":"共同亲缘","en":"Shared Kin","source":"lithoids","category":"人口与社会","namespace":"gameplay","es":"localisation/english/lithoids_l_english.yml","el":40,"zs":"localisation/simp_chinese/lithoids_l_simp_chinese.yml","zl":32,"status":"paired","id":"texts:47705"},{"key":"triggered_selective_kinship_hates","zh":"可怖外星人","en":"Horrid Alien","source":"lithoids","category":"人口与社会","namespace":"gameplay","es":"localisation/english/lithoids_l_english.yml","el":41,"zs":"localisation/simp_chinese/lithoids_l_simp_chinese.yml","zl":33,"status":"paired","id":"texts:47706"},{"key":"mod_citizen_pop_same_species_class_happiness","zh":"公民与相同§Y物种类别§!的外星人共处一地时的幸福度","en":"Citizen Happiness while sharing planet with same §YSpecies Class§!","source":"lithoids","category":"人口与社会","namespace":"gameplay","es":"localisation/english/lithoids_l_english.yml","el":42,"zs":"localisation/simp_chinese/lithoids_l_simp_chinese.yml","zl":34,"status":"paired","id":"texts:47707"},{"key":"mod_citizen_pop_different_species_class_happiness","zh":"当欺压其他§Y物种类别§!时的公民幸福度","en":"Citizen Happiness while oppressing other §YSpecies Classes§!","source":"lithoids","category":"人口与社会","namespace":"gameplay","es":"localisation/english/lithoids_l_english.yml","el":43,"zs":"localisation/simp_chinese/lithoids_l_simp_chinese.yml","zl":35,"status":"paired","id":"texts:47708"},{"key":"mod_citizen_pop_political_power","zh":"公民政治权力","en":"Citizen Political Power","source":"lithoids","category":"人口与社会","namespace":"gameplay","es":"localisation/english/lithoids_l_english.yml","el":44,"zs":"localisation/simp_chinese/lithoids_l_simp_chinese.yml","zl":36,"status":"paired","id":"texts:47709"},{"key":"civic_tooltip_selective_kinship_effects","zh":"对相同['concept_species_class']帝国的评价：§G+100§!\\n对其他帝国的评价：§R-50§!\\n和我们§Y物种同类别§!的$mod_refugee_attraction$：§G+30%§!\\n和其他§Y物种同类别§!的$mod_refugee_attraction$：§R-20%§!\\n与我们相同§Y物种类别§!的£pop£§H人口§!拥