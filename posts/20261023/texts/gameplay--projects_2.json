mp_chinese/projects_2_l_simp_chinese.yml","zl":58,"status":"paired","id":"texts:131152"},{"key":"MANUFACTORY_PROJECT_FLEET_REQUIREMENT","zh":"轨道上拥有$COUNT$/$REQUIRED$支有指挥官的军事舰队。","en":"Has $COUNT$/$REQUIRED$ Military Fleet(s) with a Commander in orbit.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":86,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":59,"status":"paired","id":"texts:131153"},{"key":"HELPFUL_DRONES_1_PROJECT","zh":"遗落之物","en":"Left Behind","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":91,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":61,"status":"paired","id":"texts:131154"},{"key":"HELPFUL_DRONES_1_PROJECT_DESC","zh":"奇怪的信号从卫星上发出。也许什么都不是。\\n\\n但也可能是重要的东西。利用轨道上的飞船作为通讯中继，殖民地科学家仔细扫描了卫星表面以探查事情的真相。","en":"Strange readings are coming from the planet's moon. It could be nothing.\\n\\nBut it could be something. With a ship in orbit acting as a relay, the colony's scientists will carefully scan the moon's surface in order to get to the heart of the matter.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":92,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":62,"status":"paired","id":"texts:131155"},{"key":"POLLEN_1_PROJECT","zh":"植物研究","en":"Floral Study","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":93,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":63,"status":"paired","id":"texts:131156"},{"key":"POLLEN_1_PROJECT_DESC","zh":"星球的当地的一些植物呈现出许多潜在的有趣特性。","en":"Some of the planet's native flora exhibit several potentially interesting properties.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":94,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":64,"status":"paired","id":"texts:131157"},{"key":"POLLEN_2_PROJECT","zh":"劳工研究","en":"Labor Study","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":95,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":65,"status":"paired","id":"texts:131158"},{"key":"POLLEN_2_PROJECT_DESC","zh":"最近，名声在外的[Root.Owner.GetSpeciesName]学术中心提出了一些组织大量劳动力的可行方法。一项对这些新方法的彻底研究可以解决在富有挑战性的殖民地环境中生产力衰退的问题。","en":"Several recent studies from reputable [Root.Owner.GetSpeciesName] seats of learning present a number of alternative ways of arranging a vast workforce. An exhaustive meta-study of these new ideas could provide the answer to the problem of declining productivity in challenging colony environments.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":96,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":66,"status":"paired","id":"texts:131159"},{"key":"POLLEN_3_PROJECT","zh":"末日将临的预兆","en":"A Sense of Impending Doom","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":97,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":67,"status":"paired","id":"texts:131160"},{"key":"POLLEN_3_PROJECT_DESC","zh":"行星上花粉感染的状况变成了某种潜在的威胁。一项对殖民地状况特别是其愈加不稳定的环境因素的快速评估至关重要。\\n\\n一旦了解了所有的威胁，可以在几小时内制定并执行一个应对方案。","en":"The situation on the pollen-infested planet has taken a turn for the potentially dangerous. A speedy assessment of the colony's unique situation and especially its increasingly volatile environmental factors is of the utmost importance.\\n\\nOnce all threats are known, an action plan can be drafted and executed within hours.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":98,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":68,"status":"paired","id":"texts:131161"},{"key":"ROGUE_SCIENTIST_1_PROJECT","zh":"漫游癖：蛛丝马迹","en":"Wanderlust: What Was Left Behind","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":103,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":71,"status":"paired","id":"texts:131162"},{"key":"ROGUE_SCIENTIST_1_PROJECT_DESC","zh":"随着首席科学官从这个星系毫无征兆的离去，大量令人困惑的残余能量信号随着太阳风被投射出去。\\n\\n但愿彻底研究这些能量能帮我们找出首席科学家的下一个目的地，甚至，如果有必要，让我们更容易地追踪他。","en":"The Chairperson's unseen departure from this system resulted in a perplexing mass of residual energy signatures being cast upon the solar winds.\\n\\nHopefully a complete analysis of these energies should point us to the Chairperson's next destination, and if need be, make them easier to track in the future.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":104,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":72,"status":"paired","id":"texts:131163"},{"key":"MASSEX_1_PROJECT","zh":"分析结果：崩坏","en":"Analysis: Broken","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":107,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":74,"status":"paired","id":"texts:131164"},{"key":"MASSEX_1_PROJECT_DESC","zh":"重构该天体悲惨的过去。","en":"Reconstruct the traumatic past of this celestial body.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":108,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":75,"status":"paired","id":"texts:131165"},{"key":"MASSEX_2_PROJECT","zh":"分析：烧毁","en":"Analysis: Burned","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":109,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":76,"st