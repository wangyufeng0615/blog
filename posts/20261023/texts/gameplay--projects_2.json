ategory":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":52,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":36,"status":"paired","id":"texts:131130"},{"key":"REFINE_ROCK_PROJECT","zh":"阳电子轰击","en":"Positron Bombardment","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":54,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":37,"status":"paired","id":"texts:131131"},{"key":"REFINE_ROCK_PROJECT_DESC","zh":"在轨可控阳电子扩散法也许可以将星球原有的矿物质变成一种更有用的形式。","en":"Controlled dispersal of positrons from orbit may change the minerals native to the planet into a more useful form.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":55,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":38,"status":"paired","id":"texts:131132"},{"key":"CRYSTAL_CODEX_PROJECT","zh":"晶体抄本","en":"Crystal Codex","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":57,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":39,"status":"paired","id":"texts:131133"},{"key":"CRYSTAL_CODEX_PROJECT_DESC","zh":"一种矿石结阵储存着某种全息编码信息。它的结构很常见，但是其中蕴含的数据密度使得它难以被解密。","en":"A mineral formation houses hologram-encoded information. Its structure is familiar, but the sheer data density makes it a challenge to decode.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":58,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":40,"status":"paired","id":"texts:131134"},{"key":"ALIEN_BARRACKS_PROJECT","zh":"外星军营","en":"Alien Barracks","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":60,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":41,"status":"paired","id":"texts:131135"},{"key":"ALIEN_BARRACKS_PROJECT_DESC","zh":"一项对于这些废墟的最新异种社会考古学研究也许能帮助我们理解这些古代外星战争机器。","en":"A closer xeno-socio-archaeological study of these ruins may provide insights into some past alien war machine.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":61,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":42,"status":"paired","id":"texts:131136"},{"key":"ROBOT_MINERALS_PROJECT","zh":"回归自然","en":"Reclaimed by Nature","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":63,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":43,"status":"paired","id":"texts:131137"},{"key":"ROBOT_MINERALS_PROJECT_DESC","zh":"一个杂草丛生的设施也许蕴藏着重要的秘密。","en":"An overgrown facility may house important secrets.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":64,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":44,"status":"paired","id":"texts:131138"},{"key":"BALANCE_ECOSYSTEM_PROJECT","zh":"生态系统平衡","en":"Balance Ecosystem","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":66,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":45,"status":"paired","id":"texts:131139"},{"key":"BALANCE_ECOSYSTEM_PROJECT_DESC","zh":"有一个仅用标准科研船上的设备就能使星球上失衡生态圈恢复平衡的方案被设计了出来。\\n\\n也许会造成无法预见的后果。","en":"A plan has been formulated to attempt to balance the planet's lopsided biosphere using only the tools available to a standard Science Ship.\\n\\nThere may be unforeseen consequences.","source":"projects_2","category":"科技与发展","namespace":"gameplay","es":"localisation/english/projects_2_l_english.yml","el":67,"zs":"localisation/simp_chinese/projects_2_l_simp_chinese.yml","zl":46,"status":"paired","id":"texts:131140"},{"key":"HEAD_IN_SAND_PROJECT","zh"